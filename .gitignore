# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# SQLite database files (never commit — may contain secrets / PII)
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm
prisma/db/*.db
prisma/db/*.db-journal
prisma/db/*.db-wal
prisma/db/*.db-shm

# Bootstrap runtime artifacts
logs/
run/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
dev.log
test
prompt

server.log
# Skills directory
/skills/